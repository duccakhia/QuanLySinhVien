<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Thanh tieu de -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:gravity="center_vertical"
            android:background="#554BD9"
            android:paddingHorizontal="20dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Đăng kí"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:gravity="center"
                android:text="☰"
                android:textColor="#FFFFFF"
                android:textSize="26sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Thông tin sinh viên"
                android:textColor="#17233E"
                android:textSize="22sp"
                android:textStyle="bold"
                android:layout_marginBottom="20dp" />

            <!-- Ho ten -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Họ tên"
                android:textColor="#52617A"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/edtHoTen"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_input"
                android:hint="Nhập họ tên"
                android:inputType="textPersonName|textCapWords"
                android:paddingHorizontal="14dp"
                android:textColor="#17233E"
                android:textSize="16sp"
                android:singleLine="true" />

            <!-- Email -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Email"
                android:textColor="#52617A"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/edtEmail"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_input"
                android:hint="Nhập email"
                android:inputType="textEmailAddress"
                android:paddingHorizontal="14dp"
                android:textColor="#17233E"
                android:textSize="16sp"
                android:singleLine="true" />

            <!-- So dien thoai -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Số điện thoại"
                android:textColor="#52617A"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/edtSdt"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_input"
                android:hint="Nhập số điện thoại"
                android:inputType="phone"
                android:paddingHorizontal="14dp"
                android:textColor="#17233E"
                android:textSize="16sp"
                android:singleLine="true" />

            <!-- MSV -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Mã số sinh viên (MSV)"
                android:textColor="#52617A"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/edtMsv"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_input"
                android:hint="Nhập MSV"
                android:inputType="text"
                android:paddingHorizontal="14dp"
                android:textColor="#17233E"
                android:textSize="16sp"
                android:singleLine="true" />

            <!-- Lop -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Lớp"
                android:textColor="#52617A"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/edtLop"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="24dp"
                android:background="@drawable/bg_input"
                android:hint="Nhập lớp"
                android:inputType="textCapCharacters"
                android:paddingHorizontal="14dp"
                android:textColor="#17233E"
                android:textSize="16sp"
                android:singleLine="true" />

            <!-- Nut dang ki -->
            <Button
                android:id="@+id/btnDangKy"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/bg_button"
                android:backgroundTint="@null"
                android:text="ĐĂNG KÍ"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:stateListAnimator="@null" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:text="Vui lòng kiểm tra thông tin trước khi đăng kí."
                android:textColor="#7B879D"
                android:textSize="12sp" />

        </LinearLayout>
    </LinearLayout>
</ScrollView>
